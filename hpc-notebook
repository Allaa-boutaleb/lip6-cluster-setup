JOBSCRIPT
NOTIFY_SED='/^__NOTIFY__$/d'
[ -n "$MAIL" ] && NOTIFY_SED="s|^__NOTIFY__\$|#OAR --notify mail:${MAIL}|"
sed -i "s/__CORES__/${CORES}/g; s/__WALL__/${WALL}/g; ${NOTIFY_SED}" ~/._jupyter_job.sh
chmod +x ~/._jupyter_job.sh
oarsub -S ~/._jupyter_job.sh 2>&1
