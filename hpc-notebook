# follow_job ID: one streamed ssh waits on the cluster until the job's Jupyter prints its URL, the job ends,
# or the wait times out (5 min in the queue, then 5 min for Jupyter). Sets NODE and URL and returns 0, or
# says why not and returns 1. Ctrl+C stops only the waiting; the job keeps running.
follow_job() {
    local jobid=$1 kind value state="" ended="" timeout="" start=$SECONDS script
    NODE="" URL=""
    # read into a variable: bash 3.2 cannot parse a heredoc with "case" inside <( )
    IFS= read -r -d '' script << 'FOLLOW'
id=$1
deadline=$((SECONDS + 300))
running=""
while [ $SECONDS -lt $deadline ]; do
    info=$(oarstat -f -j "$id" 2>/dev/null)
    state=$(printf '%s\n' "$info" | awk -F= '/^ *state =/ { gsub(/ /, "", $2); print $2; exit }')
    node=$(printf '%s\n' "$info" | awk '/assigned_hostnames/ { print $3; exit }')
    case $state in
        Running)
            [ -n "$running" ] || { running=1; deadline=$((SECONDS + 300)); }
            url=$(grep -o 'http://[^ ]*' ~/OAR."$id".stderr 2>/dev/null | tail -1)
            if [ -n "$url" ] && [ -n "$node" ]; then echo "NODE $node"; echo "URL $url"; exit 0; fi ;;
        Waiting|toLaunch|Launching|Hold|"") ;;
        *) echo "END $state"; exit 0 ;;
    esac
    echo "STATE ${state:-Waiting}"
    sleep 2
done
echo "TIMEOUT"
FOLLOW
    trap 'printf "\n"' INT
    while read -r kind value; do
        case $kind in
            STATE) state=$value; printf "\r\033[K  ${DIM}%s... (%ss)${NC}" "$value" "$((SECONDS - start))" ;;
            NODE) NODE=$value ;;
            URL) URL=$value ;;
            END) ended=$value ;;
            TIMEOUT) timeout=1 ;;
        esac
    done < <(rssh hpc bash -s "'$jobid'" <<< "$script" 2>"$SSH_ERR")
    trap - INT
    [ -z "$state" ] || printf "\r\033[K"
    if [ -n "$URL" ] && is_name "$NODE"; then
        return 0
    elif [ -n "$ended" ]; then
        echo -e "${RED}Job $jobid is no longer waiting (state: $ended)${NC}"
        echo -e "Check logs: ${DIM}ssh hpc 'cat ~/OAR.${jobid}.stderr'${NC}"
    elif [ -n "$timeout" ] && [ "$state" = Running ]; then
        echo -e "${RED}Jupyter didn't start.${NC}"
        echo -e "Check logs: ${DIM}ssh hpc 'cat ~/OAR.${jobid}.stderr'${NC}"
    elif [ -n "$timeout" ]; then
        echo -e "${YELLOW}Still queued after 5 min. Job $jobid is waiting for resources.${NC}"
        echo -e "Use option 2 to connect later, or option 4 to cancel."
    else
        echo -e "${YELLOW}Stopped waiting.${NC} Job $jobid keeps running on the cluster: connect later with option 2, cancel with option 4."
        [ -s "$SSH_ERR" ] && tail -n 3 "$SSH_ERR" | sed 's/^/    /'
    fi
    return 1
}

connect_to_job() {
    local jobid="$1"
    local mode="${2:-1}"

    echo -e "${CYAN}Waiting for Jupyter on job $jobid...${NC}"
    follow_job "$jobid" || return
    local node=$NODE url=$URL
    echo -e "${CYAN}Running on ${BOLD}$node${NC}"

    # Parse actual port from Jupyter URL
    local remote_port
    remote_port=$(printf '%s\n' "$url" | sed -n 's|.*:\([0-9][0-9]*\)/.*|\1|p' | head -1)
    if ! is_int "$remote_port"; then
        echo -e "${RED}Could not determine Jupyter port.${NC}"
        return
    fi
    tunnel_start "$jobid" "$node:$remote_port" hpc || return
    local local_url
    local_url=$(echo "$url" | sed "s|http://[^:]*:${remote_port}|http://127.0.0.1:${TUNNEL_PORT}|")

    echo ""
    echo -e "${GREEN}================================================${NC}"
    echo -e "${GREEN}  Session ready!${NC}"
    echo -e "${GREEN}================================================${NC}"
    echo ""
    echo -e "  ${BOLD}Job:${NC}   $jobid"
    echo -e "  ${BOLD}Node:${NC}  $node"
    echo -e "  ${BOLD}URL:${NC}   ${CYAN}$local_url${NC}"
    echo ""

    echo -e "${GREEN}Tunnel running in background; it stays up after you quit or close this window.${NC}"
    echo -e "${DIM}Use option 4 (Cleanup) to disconnect.${NC}"

    echo -e "${CYAN}Opening Jupyter in browser...${NC}"
    open_url "$local_url"

    if [ "$mode" = "3" ]; then
        echo ""
        echo -e "${BOLD}To open a terminal on $node, run in another tab:${NC}"
        echo ""
        echo -e "  ${GREEN}ssh -t hpc \"OAR_JOB_ID=$jobid oarsh $node\"${NC}"
        echo ""
        echo -e "${DIM}Or with Kitty:${NC}"
        echo ""
        echo -e "  ${GREEN}kitty +kitten ssh -t hpc \"OAR_JOB_ID=$jobid oarsh $node\"${NC}"
    fi
}

my_jobs() {
    echo ""
    echo -e "${DIM}Loading, please wait...${NC}"
    local output
    output=$(rssh hpc "oarstat -u \"\$USER\"" 2>"$SSH_ERR") || {
        ssh_failed "Could not list your jobs on HPC."
        return
    }
    if echo "$output" | grep -q "^[0-9]"; then
        echo -e "${BOLD}Your jobs:${NC}"
        echo ""
        echo "$output"
    else
        echo -e "${DIM}No running jobs.${NC}"
    fi
    echo ""
}

# cancel_jobs "ID ..."  oardel each job; a job's log files are deleted only after its oardel succeeded.
# Failures are reported on stderr (-> $SSH_ERR); status is non-zero if any job was not cancelled.
cancel_jobs() {
    rssh hpc bash -s "'$1'" 2>"$SSH_ERR" << 'REMOTE'
fail=0
for j in $1; do
    if out=$(oardel "$j" 2>&1); then
        rm -f ~/OAR."$j".stderr ~/OAR."$j".stdout
    else
        echo "job $j: ${out:-oardel failed}" >&2
        fail=1
    fi
done
exit $fail
REMOTE
}

cancel_job() {
    echo ""
    echo -e "${DIM}Loading, please wait...${NC}"
    local output
    output=$(rssh hpc "oarstat -u \"\$USER\"" 2>"$SSH_ERR") || {
        ssh_failed "Could not list your jobs on HPC."
        return
    }
    if ! echo "$output" | grep -q "^[0-9]"; then
        echo -e "${DIM}No running jobs to cancel.${NC}"
        return
    fi
    echo -e "${BOLD}Your jobs:${NC}"
    echo ""
    echo "$output"
    echo ""
    echo -e "Enter a job ID to cancel, or ${BOLD}all${NC} to cancel everything."
    ask "> " jobid
    if [ "$jobid" = "all" ]; then
        local ids total answer
        ids=$(echo "$output" | awk '/^[0-9]/{printf "%s ", $1}')
        total=$(echo "$output" | awk '/^[0-9]/{n++} END{print n+0}')
        echo -e "${YELLOW}This cancels ALL ${total} of your jobs and deletes their log files.${NC}"
        ask "Type yes to confirm: " answer
        if [ "$answer" != "yes" ]; then
            echo -e "${DIM}Nothing cancelled.${NC}"
        elif cancel_jobs "$ids"; then
            echo -e "${GREEN}All ${total} jobs cancelled and log files cleaned up.${NC}"
        else
            ssh_failed "Not every job was cancelled (the log files of those jobs were kept)."
        fi
    elif is_int "$jobid"; then
        if cancel_jobs "$jobid"; then
            echo -e "${GREEN}Job $jobid cancelled and log files cleaned up.${NC}"
        else
            ssh_failed "Could not cancel job $jobid (its log files were kept)."
        fi
    elif [ -n "$jobid" ]; then
        echo -e "${RED}Invalid job ID (must be a number, or 'all').${NC}"
    fi
}

connect_existing() {
    echo ""
    echo -e "${DIM}Loading, please wait...${NC}"
    local output
    output=$(rssh hpc "oarstat -u \"\$USER\"" 2>"$SSH_ERR") || {
        ssh_failed "Could not list your jobs on HPC."
        return
    }
    if ! echo "$output" | grep -q "^[0-9]"; then
        echo -e "${DIM}No running jobs to connect to.${NC}"
        return
    fi

    local job_ids=($(echo "$output" | awk '/^[0-9]/{print $1}'))
    local jobid=""

    if [ ${#job_ids[@]} -eq 1 ]; then
        jobid="${job_ids[0]}"
        echo -e "Auto-selecting your only running job: ${BOLD}$jobid${NC}"
    else
        echo -e "${BOLD}Your jobs:${NC}"
        echo ""
        echo "$output"
        echo ""
        echo -e "Enter the job ID you want to connect to:"
        ask "> " jobid
    fi

    if [ -z "$jobid" ]; then
        return
    fi
    if ! is_int "$jobid"; then
        echo -e "${RED}Invalid job ID (must be a number).${NC}"
        return
    fi
    case " ${job_ids[*]} " in
        *" $jobid "*) ;;
        *) echo -e "${RED}Job $jobid is not one of your jobs (see option 3).${NC}"; return ;;
    esac

    echo ""
    echo -e "${BOLD}How do you want to connect?${NC}"
    echo -e "  ${GREEN}1${NC})  Jupyter Lab (opens in browser)"
    echo -e "  ${GREEN}2${NC})  Terminal only"
    echo -e "  ${GREEN}3${NC})  Both (Jupyter + terminal access)"
    echo ""
    ask "> " mode
    mode="${mode:-1}"
    if ! [[ "$mode" =~ ^[1-3]$ ]]; then
        echo -e "${RED}Choose 1, 2, or 3.${NC}"
        return
    fi

    if [ "$mode" = "2" ]; then
        local node
        node=$(rssh hpc "oarstat -f -j '$jobid' | grep 'assigned_hostnames' | awk '{print \$3}'" 2>"$SSH_ERR") || node=""
        if [ -z "$node" ] || ! is_name "$node"; then
            ssh_failed "Could not find the node for job $jobid (is it running yet? see option 3)."
            return
        fi
        echo -e "${CYAN}Connecting to $node...${NC}"
        ssh_session -t hpc "OAR_JOB_ID='$jobid' oarsh '$node'"
    else
        connect_to_job "$jobid" "$mode"
    fi
}

# Entry point. The first status check runs in the background (stopped after 15 s), so the menu shows at once.
welcome
STATUS_FILE="${TMPDIR:-/tmp}/lip6-status.$$"
( collect_status > "$STATUS_FILE.part" 2>/dev/null && mv "$STATUS_FILE.part" "$STATUS_FILE" ) &
PROBE_PID=$!
( end=$((SECONDS + 15)); while kill -0 "$PROBE_PID" 2>/dev/null; do
    [ $SECONDS -lt $end ] || { kill "$PROBE_PID"; break; }; sleep 1; done ) 2>/dev/null &
trap 'rm -f "$SSH_ERR" "$STATUS_FILE" "$STATUS_FILE.part"; kill "$PROBE_PID" 2>/dev/null' EXIT
STATUS_LOGIN="checking..."

while true; do
    if [ -f "$STATUS_FILE" ]; then
        load_status "$(cat "$STATUS_FILE")"
        rm -f "$STATUS_FILE"
    fi
    echo ""
    render_status
    show_menu
    ask "> " choice
    case $choice in
        1) launch_session ;;
        2) connect_existing ;;
        3) my_jobs ;;
        4) cancel_job; sever_tunnel ;;
        5) ssh_session hpc ;;
        r|R) refresh_status ;;
        q|Q) echo -e "\n${DIM}Bye!${NC}\n"; exit 0 ;;
        *) echo -e "${RED}Invalid choice.${NC}" ;;
    esac
done
