# cancel_jobs "ID ..."  oardel each job; a job's log files are deleted only after its oardel succeeded.
# Failures are reported on stderr (-> $SSH_ERR); status is non-zero if any job was not cancelled.
cancel_jobs() {
    ssh hpc bash -s "'$1'" 2>"$SSH_ERR" << 'REMOTE'
fail=0
for j in $1; do
    if out=$(oardel "$j" 2>&1); then
        rm -f ~/OAR."$j".stderr ~/OAR."$j".stdout
    else
        echo "job $j: ${out:-oardel failed}" >&2
        fail=1
    fi
done
exit $fail
REMOTE
}

cancel_job() {
    echo ""
    echo -e "${DIM}Loading, please wait...${NC}"
    local output
    output=$(ssh hpc "oarstat -u \"\$USER\"" 2>"$SSH_ERR") || {
        ssh_failed "Could not list your jobs on HPC."
        return
    }
    if ! echo "$output" | grep -q "^[0-9]"; then
        echo -e "${DIM}No running jobs to cancel.${NC}"
        return
    fi
    echo -e "${BOLD}Your jobs:${NC}"
    echo ""
    echo "$output"
    echo ""
    echo -e "Enter a job ID to cancel, or ${BOLD}all${NC} to cancel everything."
    ask "> " jobid
    if [ "$jobid" = "all" ]; then
        local ids total answer
        ids=$(echo "$output" | awk '/^[0-9]/{printf "%s ", $1}')
        total=$(echo "$output" | awk '/^[0-9]/{n++} END{print n+0}')
        echo -e "${YELLOW}This cancels ALL ${total} of your jobs and deletes their log files.${NC}"
        ask "Type yes to confirm: " answer
        if [ "$answer" != "yes" ]; then
            echo -e "${DIM}Nothing cancelled.${NC}"
        elif cancel_jobs "$ids"; then
            echo -e "${GREEN}All ${total} jobs cancelled and log files cleaned up.${NC}"
        else
            ssh_failed "Not every job was cancelled (the log files of those jobs were kept)."
        fi
    elif is_int "$jobid"; then
        if cancel_jobs "$jobid"; then
            echo -e "${GREEN}Job $jobid cancelled and log files cleaned up.${NC}"
        else
            ssh_failed "Could not cancel job $jobid (its log files were kept)."
        fi
    elif [ -n "$jobid" ]; then
        echo -e "${RED}Invalid job ID (must be a number, or 'all').${NC}"
    fi
}

connect_existing() {
    echo ""
    echo -e "${DIM}Loading, please wait...${NC}"
    local output
    output=$(ssh hpc "oarstat -u \"\$USER\"" 2>"$SSH_ERR") || {
        ssh_failed "Could not list your jobs on HPC."
        return
    }
    if ! echo "$output" | grep -q "^[0-9]"; then
        echo -e "${DIM}No running jobs to connect to.${NC}"
        return
    fi

    local job_ids=($(echo "$output" | awk '/^[0-9]/{print $1}'))
    local jobid=""

    if [ ${#job_ids[@]} -eq 1 ]; then
        jobid="${job_ids[0]}"
        echo -e "Auto-selecting your only running job: ${BOLD}$jobid${NC}"
    else
        echo -e "${BOLD}Your jobs:${NC}"
        echo ""
        echo "$output"
        echo ""
        echo -e "Enter the job ID you want to connect to:"
        ask "> " jobid
    fi

    if [ -z "$jobid" ]; then
        return
    fi
    if ! is_int "$jobid"; then
        echo -e "${RED}Invalid job ID (must be a number).${NC}"
        return
    fi
    case " ${job_ids[*]} " in
        *" $jobid "*) ;;
        *) echo -e "${RED}Job $jobid is not one of your jobs (see option 3).${NC}"; return ;;
    esac

    echo ""
    echo -e "${BOLD}How do you want to connect?${NC}"
    echo -e "  ${GREEN}1${NC})  Jupyter Lab (opens in browser)"
    echo -e "  ${GREEN}2${NC})  Terminal only"
    echo -e "  ${GREEN}3${NC})  Both (Jupyter + terminal access)"
    echo ""
    ask "> " mode
    mode="${mode:-1}"
    if ! [[ "$mode" =~ ^[1-3]$ ]]; then
        echo -e "${RED}Choose 1, 2, or 3.${NC}"
        return
    fi

    if [ "$mode" = "2" ]; then
        local node
        node=$(ssh hpc "oarstat -f -j '$jobid' | grep 'assigned_hostnames' | awk '{print \$3}'" 2>"$SSH_ERR") || node=""
        if [ -z "$node" ] || ! is_name "$node"; then
            ssh_failed "Could not find the node for job $jobid (is it running yet? see option 3)."
            return
        fi
        echo -e "${CYAN}Connecting to $node...${NC}"
        ssh_session -t hpc "OAR_JOB_ID='$jobid' oarsh '$node'"
    else
        connect_to_job "$jobid" "$mode"
    fi
}

sever_tunnel() {
    echo ""
    local found=false
    for f in "$TUNNEL_DIR"/*; do
        [ -f "$f" ] || continue
        local tid
        tid=$(basename "$f")
        local pid port
        read -r pid port < "$f"
        if kill -0 "$pid" 2>/dev/null; then
            echo -e "  ${GREEN}Job $tid${NC} — localhost:$port (PID $pid)"
            found=true
        else
            rm -f "$f"
        fi
    done

    if ! $found; then
        echo -e "${DIM}No active tunnels.${NC}"
        return
    fi

    echo ""
    echo -e "Enter a job ID to disconnect, or ${BOLD}all${NC} to disconnect everything."
    ask "> " choice
    if [ "$choice" = "all" ]; then
        for f in "$TUNNEL_DIR"/*; do
            [ -f "$f" ] || continue
            read -r pid port < "$f"
            kill "$pid" 2>/dev/null
            rm -f "$f"
        done
        echo -e "${GREEN}All tunnels disconnected.${NC}"
    elif is_int "$choice" && [ -f "${TUNNEL_DIR}/${choice}" ]; then
        read -r pid port < "${TUNNEL_DIR}/${choice}"
        kill "$pid" 2>/dev/null
        rm -f "${TUNNEL_DIR}/${choice}"
        echo -e "${GREEN}Tunnel for job $choice disconnected.${NC}"
    elif [ -n "$choice" ]; then
        echo -e "${RED}Invalid choice.${NC}"
    fi
}

# Entry point
welcome
refresh_status

while true; do
    echo ""
    render_status
    show_menu
    ask "> " choice
    case $choice in
        1) launch_session ;;
        2) connect_existing ;;
        3) my_jobs ;;
        4) cancel_job; sever_tunnel ;;
        5) ssh_session hpc ;;
        r|R) refresh_status ;;
        q|Q) echo -e "\n${DIM}Bye!${NC}\n"; exit 0 ;;
        *) echo -e "${RED}Invalid choice.${NC}" ;;
    esac
done
