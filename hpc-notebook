        return
    fi

    echo ""
    echo -e "${BOLD}How long do you need?${NC}"
    echo -e "  ${DIM}Press Enter for 24 hours. Examples: 8h, 1d 6h, 24:0:0${NC}"
    ask "> " wall_input
    wall_input="${wall_input:-24h}"
    wall=$(parse_duration "$wall_input") || {
        echo -e "${RED}Invalid duration. Use 8h, 1d 6h, 30m, or H:M:S.${NC}"
        return
    }

    echo ""
    echo -e "${BOLD}How do you want to work?${NC}"
    echo -e "  ${GREEN}1${NC})  Jupyter Lab (opens in browser)"
    echo -e "  ${GREEN}2${NC})  Terminal only (SSH into compute node)"
    echo -e "  ${GREEN}3${NC})  Both (Jupyter + terminal access)"
    echo ""
    ask "> " mode
    mode="${mode:-1}"
    if ! [[ "$mode" =~ ^[1-3]$ ]]; then
        echo -e "${RED}Choose 1, 2, or 3.${NC}"
        return
    fi

    echo ""
    echo -e "${CYAN}Submitting job: ${cores} cores, ${wall}...${NC}"
    echo -e "${DIM}oarsub -l /nodes=1/core=${cores},walltime=${wall} -p \"host like 'big%'\"${NC}"

    if [ "$mode" = "2" ]; then
        echo ""
        echo -e "${YELLOW}Terminal mode requires an interactive OAR session.${NC}"
        echo -e "Opening SSH to the cluster..."
        echo ""
        echo -e "${DIM}Run this on the cluster:${NC}"
        echo -e "  ${GREEN}oarsub -l /nodes=1/core=${cores},walltime=${wall} -p \"host like 'big%'\" -I${NC}"
        echo ""
        ssh_session hpc
        return
    fi

    # oarsub's whole output comes back: the job id on success, its rejection message otherwise
    out=$(ssh hpc bash -s "'$cores'" "'$wall'" "'$MAIL_TO'" 2>"$SSH_ERR" << 'REMOTE'
CORES="$1"
