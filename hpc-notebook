# stderr of the last ssh call lands here, so a failure can say why
SSH_ERR="${TMPDIR:-/tmp}/lip6-ssh-err.$$"
trap 'rm -f "$SSH_ERR"' EXIT

# ask PROMPT VAR: read one line; end of input (Ctrl-D, closed stdin) quits instead of spinning
ask() { read -r -p "$1" "$2" || { echo -e "\n${DIM}Bye!${NC}\n"; exit 0; }; }

# ssh_failed WHAT: say what failed, the ssh/OAR message saved in $SSH_ERR, and what to try next
ssh_failed() {
    echo -e "${RED}$1${NC}"
    [ -s "$SSH_ERR" ] && tail -n 5 "$SSH_ERR" | sed 's/^/    /'
    echo -e "${DIM}Check the message above, your network/VPN and the job id, then try again (test the link: ssh hpc true).${NC}"
}

# ssh_session ARGS: interactive ssh; its status is the remote shell's, only 255 means ssh itself failed
ssh_session() {
    ssh "$@"
    [ $? -ne 255 ] || echo -e "\n${RED}Could not connect.${NC} ${DIM}Check your network/VPN, then try again (test the link: ssh hpc true).${NC}"
}

# submit_failed OUT: oarsub gave no job id; show its message (or the ssh error) and the next step
submit_failed() {
    echo -e "${RED}Job was NOT submitted.${NC}"
    if [ -n "$1" ]; then
        printf '%s\n' "$1" | tail -n 8 | sed 's/^/    /'
    elif [ -s "$SSH_ERR" ]; then
        tail -n 5 "$SSH_ERR" | sed 's/^/    /'
    fi
    echo -e "${DIM}Fix the cause above (e.g. ask for fewer cores or less time) and try again. If unsure whether it went through, check Jobs (option 3) first.${NC}"
}

