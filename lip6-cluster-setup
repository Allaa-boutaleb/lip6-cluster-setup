INSTALL_DIR="$HOME"

# Copy a manager from this repo checkout, filling in the one MAIL_TO line.
# The managers carry no username: they ask the cluster who you are.
install_manager() {
    local name="$1"
    local dest="${INSTALL_DIR}/${name}"
    local escaped_email
    escaped_email=$(printf '%s' "$EMAIL" | sed 's/[\\/&|]/\\&/g')
    sed "s|^MAIL_TO=\"\"\$|MAIL_TO=\"${escaped_email}\"|" "${SCRIPT_DIR}/${name}" > "${dest}.tmp" \
        && mv "${dest}.tmp" "$dest" \
        && chmod +x "$dest" \
        || { echo -e "${RED}Could not install ${dest}${NC}"; exit 1; }
}

