# setup_alias FILE NAME CMD: replace any old "alias NAME=" line in FILE (bash, zsh and fish all accept this form)
setup_alias() {
    local file="$1"
    local name="$2"
    local cmd="$3"

    [ ! -f "$file" ] || filter_file "$file" "!/alias ${name}=/"
    echo "alias ${name}=\"${cmd}\"" >> "$file"
}

# Detect shell
SHELL_NAME=$(basename "${SHELL:-bash}")
case "$SHELL_NAME" in
    fish) SHELL_CONFIG="$HOME/.config/fish/config.fish"; mkdir -p "$HOME/.config/fish" ;;
    zsh) SHELL_CONFIG="$HOME/.zshrc" ;;
    *) SHELL_CONFIG="$HOME/.bashrc" ;;
esac
if $SETUP_HPC; then setup_alias "$SHELL_CONFIG" "hpc" "~/hpc-notebook"; fi
if $SETUP_CONV; then setup_alias "$SHELL_CONFIG" "conv" "~/conv-manager"; fi
echo -e "${GREEN}Aliases added to ${SHELL_CONFIG}${NC}"

# Login shells (macOS Terminal, Git Bash) read ~/.bash_profile or ~/.profile, not ~/.bashrc: make them load it
if [ "$SHELL_CONFIG" = "$HOME/.bashrc" ]; then
    PROFILE="$HOME/.bash_profile"
    [ -f "$PROFILE" ] || [ ! -f "$HOME/.profile" ] || PROFILE="$HOME/.profile"
    if ! grep -q 'bashrc' "$PROFILE" 2>/dev/null; then
        echo '[ -n "$BASH_VERSION" ] && [ -f ~/.bashrc ] && . ~/.bashrc' >> "$PROFILE"
        echo -e "${GREEN}${PROFILE} now loads ~/.bashrc${NC} ${DIM}(so login shells see the aliases)${NC}"
    fi
fi

