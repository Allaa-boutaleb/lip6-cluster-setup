# install_remote_block MARKER < TEXT: put TEXT between "# BEGIN/END MARKER" lines in ~/.bashrc, replacing the old
# block. The previous file is kept as ~/.bashrc.lip6-bak; a BEGIN without END or a failed write changes nothing.
install_remote_block() {
    marker="$1"
    content=$(cat)
    [ -f ~/.bashrc ] || touch ~/.bashrc
    tmp=$(mktemp ~/.bashrc.lip6.XXXXXX) && cp -p ~/.bashrc ~/.bashrc.lip6-bak && cp -p ~/.bashrc "$tmp" || return 1
    if awk -v begin="# BEGIN ${marker}" -v end="# END ${marker}" '
        $0 == begin { skip=1; next }
        $0 == end { skip=0; next }
        !skip { print }
        END { if (skip) exit 3 }
    ' ~/.bashrc > "$tmp" && printf '%s\n%s\n%s\n' "# BEGIN ${marker}" "$content" "# END ${marker}" >> "$tmp" \
        && mv "$tmp" ~/.bashrc; then
        return 0
    fi
    rm -f "$tmp"
    echo "~/.bashrc left unchanged: '# BEGIN ${marker}' has no matching '# END' line (or the write failed)." >&2
    return 1
}

